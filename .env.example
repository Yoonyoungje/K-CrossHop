# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋되지 않는다(.gitignore).

# 05_pilot_runner / 06_annotate 가 쓰는 생성·판정 API 키.
# 재현하려는 모델에 해당하는 키만 있으면 된다.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Wikidata / Wikipedia API 호출에 쓰는 User-Agent.
# Wikimedia 정책상 연락 가능한 주소를 포함하도록 권장된다 — 재현자 본인 것으로 채운다.
# 미설정 시 "K-CrossHop-Research/1.0 (research use)" 로 동작한다.
WIKI_USER_AGENT=
